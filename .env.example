# Frontend (Vite) env — copy to .env.local. Only VITE_* vars reach the browser.
# anon key is safe to commit/expose; service role is NOT (stays in edge functions).
VITE_SUPABASE_URL=https://ihkybryikwlkppqpfnly.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
# Bearer secret for write edge functions (add-flight/import-csv). Build-time only,
# single-user app. Leave blank to run read-only.
VITE_EDGE_FUNCTION_SECRET=
